[Unit]
Description=Storm Chaser bounded JMA collection cycle
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=storm-chaser
WorkingDirectory=/opt/storm-chaser
Environment=STORM_DATA_DIR=/var/lib/storm-chaser
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node --import tsx server/once.ts
TimeoutStartSec=240
StateDirectory=storm-chaser
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/storm-chaser
